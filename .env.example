ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
COOKIE_SECRET=...   # generate: python -c "import secrets; print(secrets.token_hex(32))"

# PostgreSQL via Supabase (or any Postgres instance)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# URLs — for local dev use the localhost values below
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Rate limiting — max PDF uploads per user per day
DAILY_UPLOAD_LIMIT=10

# Set to "production" on Railway; controls SameSite cookie and CORS
ENVIRONMENT=development
